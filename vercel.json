{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rinoseller-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/c/:id",
      "destination": "https://rinoseller-api-production.up.railway.app/c/:id"
    },
    {
      "source": "/((?!api/|c/|assets/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
